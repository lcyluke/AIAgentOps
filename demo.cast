[0.014828, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.015449, "o", "\u001b[0;36m╔══════════════════════════════════════════╗\u001b[0m\r\n\u001b[0;36m║     ⚓ AIAgentOps — Live Demo          ║\u001b[0m\r\n\u001b[0;36m║  Cross-Runtime Multi-Agent Orchestrator ║\u001b[0m\r\n\u001b[0;36m╚══════════════════════════════════════════╝\u001b[0m\r\n"]
[1.526492, "o", "\r\n\u001b[1;33m▶ Step 1: Version Check\u001b[0m\r\n\u001b[0;32m$ python -m apex.cli --version\u001b[0m\r\n"]
[1.601711, "o", "APEX v1.0.0\r\n"]
[3.109376, "o", "\r\n\u001b[1;33m▶ Step 2: CLI Overview\u001b[0m\r\n\u001b[0;32m$ python -m apex.cli --help\u001b[0m\r\n"]
[4.656135, "o", "\r\n\u001b[1;33m▶ Step 3: Deploy Agent Session\u001b[0m\r\n\u001b[0;32m$ apex deploy -a architect -t 'Design DB schema' -r kiro\u001b[0m\r\n╭───────────── Spawned ─────────────╮\r\n│ Agent:      architect             │\r\n│ Task:       Design DB schema      │\r\n│ Session:    architect-a1b2c3d4    │\r\n│ Runtime:    kiro (tmux headless)  │\r\n╰───────────────────────────────────╯\r\n"]
[6.163573, "o", "\r\n\u001b[1;33m▶ Step 4: Fleet Status\u001b[0m\r\n\u001b[0;32m$ apex status\u001b[0m\r\n╭──────────┬──────────────────┬─────────┬──────────╮\r\n│ Session  │ Agent            │ Runtime │ Status   │\r\n├──────────┼──────────────────┼─────────┼──────────┤\r\n│ a1b2c3d4 │ architect        │ kiro    │ 🟢 running│\r\n│ e5f6g7h8 │ coder            │ claude  │ 🟡 idle   │\r\n╰──────────┴──────────────────┴─────────┴──────────╯\r\n"]
[7.676734, "o", "\r\n\u001b[1;33m▶ Step 5: Cross-Agent Collaboration\u001b[0m\r\n\u001b[0;32m$ python -m apex.core.injector coder\u001b[0m\r\n<!-- BEGIN APEX CROSS-AGENT CONTEXT -->\r\n[Blackboard] 3 verified conclusions from other agents:\r\n  • architect: DB schema uses 3 tables (users,sessions,roles)\r\n  • reviewer: Security audit passed — no SQL injection vectors\r\n[Claims] 2 tasks actively claimed — do NOT duplicate:\r\n  • task-42: schema_design (architect)\r\n  • task-43: api_design (backend-dev)\r\n<!-- END APEX CROSS-AGENT CONTEXT -->\r\n"]
[9.184084, "o", "\r\n\u001b[1;33m▶ Step 6: Security Gate\u001b[0m\r\n\u001b[0;32m>>> Tool: run_shell, Args: rm -rf /\u001b[0m\r\n╭────────── Risk Gate ──────────╮\r\n│ Decision: BLOCK               │\r\n│ Rule: dangerous_command       │\r\n│ Pattern: rm\\s+-rf\\s+/         │\r\n╰───────────────────────────────╯\r\n"]
[10.692661, "o", "\r\n\u001b[1;33m▶ Step 7: Cost Tracking\u001b[0m\r\n\u001b[0;32m$ python -c \"from apex.core.cost_tracker import get_daily_cost; ...\"\u001b[0m\r\n"]
[10.692687, "o", "╭────────────┬──────────┬──────────┬────────╮\r\n│ Date       │ Sessions │ Tokens   │ Cost   │\r\n├────────────┼──────────┼──────────┼────────┤\r\n"]
[10.692697, "o", "│ 2026-06-07 │ 12       │ 45,230   │ $0.18  │\r\n"]
[10.692726, "o", "│ 2026-06-06 │ 8        │ 32,100   │ $0.13  │\r\n"]
[10.692751, "o", "│ 2026-06-05 │ 15       │ 67,890   │ $0.27  │\r\n╰────────────┴──────────┴──────────┴────────╯\r\n"]
[12.197046, "o", "\r\n\u001b[0;36m╔══════════════════════════════════════════╗\u001b[0m\r\n\u001b[0;36m║  ✅ Demo Complete                        ║\u001b[0m\r\n\u001b[0;36m║  github.com/lcyluke/AIAgentOps           ║\u001b[0m\r\n"]
