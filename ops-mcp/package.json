{
  "name": "apex-ops-mcp",
  "version": "1.0.0",
  "description": "APEX operations MCP server — manage multi-agent sessions from Kiro/Cursor",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apex-ops-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0"
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": ["dist/index.js"]
    }
  }
}
